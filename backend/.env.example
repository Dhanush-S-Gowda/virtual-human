# Use your provider key; the placeholder works with local OpenAI-compatible servers.
LLM_API_KEY=not-needed
# Leave empty for unauthenticated local Kokoro; set this for hosted TTS providers.
TTS_API_KEY=
OPENOBSERVE_USER=
OPENOBSERVE_PASSWORD=

OPENOBSERVE_URL=http://localhost:5080
OPENOBSERVE_ORG=default
OPENOBSERVE_ENABLED=true
